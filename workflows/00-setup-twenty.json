      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        360
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_URL }}/rest/metadata/webhooks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpBearerAuth": {
          "id": null,
          "name": "Twenty – Muster"
        }
      },
      "id": "1567f9b8-db8f-4ddd-a792-a332a87b923e"
    },
    {
      "name": "Check Webhook Registration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        360
      ],
      "parameters": {
        "jsCode": "const target = $env.TWENTY_WEBHOOK_TARGET_URL;\nconst secret = $env.TWENTY_WEBHOOK_SECRET;\nif (!target || !secret) throw new Error('TWENTY_WEBHOOK_TARGET_URL / TWENTY_WEBHOOK_SECRET not set');\n\nconst existing = ($json.data ?? []).find((w) => w.targetUrl === target);\nreturn [{ json: {\n  existingId: existing?.id ?? '',\n  body: {\n    targetUrl: target,\n    operations: ['opportunity.updated'],\n    description: 'n8n WF-03 Deal Won -> ERP',\n    secret,\n  },\n} }];"
      },
      "id": "7d763399-112f-4d96-a6bb-408b8d9bc16b"
    },
    {
      "name": "Webhook Exists?",
      "type": "n8n-nodes-base.if",
