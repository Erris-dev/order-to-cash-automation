      "id": "ebe0dfa0-c4fd-433d-a483-430871e60cb6",
      "name": "Note: 1 · Receive & authenticate",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -40
      ],
      "parameters": {
        "content": "## 1 · Receive & authenticate\n**POST /webhook/lead-intake** from the website contact form.\n\nThe site signs every request:\n`X-Muster-Timestamp: <unix seconds>`\n`X-Muster-Signature: sha256=HMAC_SHA256(secret, timestamp + \".\" + raw body)`\n\nThe signature is checked on the **raw bytes** (Webhook option *Raw Body*), in constant time,\nand requests older than 5 minutes are refused (replay protection).\nBad signature → **401**, logged to `event_log`.",
        "width": 700,
        "height": 760,
        "color": 7
      }
    },
    {
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "401c229c-d812-41b5-adef-11f5bc77f831",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "9bf5bfc6-4944-4942-a4c3-84bf26ac9568"
    },
    {
      "name": "Verify HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst MAX_AGE_SECONDS = 300;\n\nconst item = $input.first();\nconst headers = item.json.headers ?? {};\nconst secret = $env.LEAD_WEBHOOK_HMAC_SECRET;\nif (!secret) throw new Error('LEAD_WEBHOOK_HMAC_SECRET is not set'); // config problem -> WF-07\n\nconst reject = (reason) => [{ json: { valid: false, reason } }];\n\nconst timestamp = String(headers['x-muster-timestamp'] ?? '');\nconst signature = String(headers['x-muster-signature'] ?? '');\nif (!timestamp || !signature.startsWith('sha256=')) return reject('missing_signature_headers');\n\nconst age = Math.abs(Date.now() / 1000 - Number(timestamp));\nif (!Number.isFinite(age) || age > MAX_AGE_SECONDS) return reject('timestamp_outside_window');\nif (!item.binary?.data) return reject('empty_body');\n\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = crypto.createHmac('sha256', secret).update(timestamp + '.').update(raw).digest();\nconst given = Buffer.from(signature.slice('sha256='.length), 'hex');\nif (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return reject('signature_mismatch');\n\nlet body;\ntry { body = JSON.parse(raw.toString('utf8')); } catch { return reject('invalid_json'); }\nreturn [{ json: { valid: true, body } }];"
      },
      "id": "c647d3b7-cd1a-4792-ac0e-8c811b40a96b"
    },
