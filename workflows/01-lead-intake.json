    {
      "id": "f60c3cc3-2c45-42d8-aa30-70b514207572",
      "name": "Note: 4 · Sync to Twenty CRM",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1780,
        -120
      ],
      "parameters": {
        "content": "## 4 · Sync to Twenty CRM\n**Company**: look up by domain (or exact name when there is no business domain);\ncreate it only if nothing matches. No company info → the person is created without one.\n**Person**: `upsert=true` on the email, so a returning lead updates the same record.\n**Opportunity**: created once per lead (stage **NEW**, amount = estimated budget in EUR).\nReturning leads keep their existing opportunity.\nAll HTTP nodes retry 3× on failure; after that the error goes to WF-07.",
        "width": 1580,
        "height": 820,
        "color": 4
      }
    },
