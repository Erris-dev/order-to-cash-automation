    {
      "id": "ac669734-d2e5-4678-a950-a07eee3b6927",
      "name": "Note: 2 · Validate & normalise",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        640,
        -40
      ],
      "parameters": {
        "content": "## 2 · Validate & normalise\nRequired: valid **email**, a **name**, **consent = true** (GDPR).\nNormalises whitespace, email case, phone format, country code, and picks the\nreply language (**de** for DE/AT/CH/LI/LU unless the form says otherwise).\nThe company domain comes from `website`, or from the email domain unless it is a\nfree-mail provider (gmail.com, web.de, …).\nInvalid → **422** with the list of problems.",
        "width": 700,
        "height": 520,
        "color": 7
      }
    },
    {
      "name": "Validate & Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const FREE_MAIL = new Set(['gmail.com', 'googlemail.com', 'yahoo.com', 'yahoo.de', 'outlook.com', 'outlook.de',\n  'hotmail.com', 'hotmail.de', 'live.com', 'icloud.com', 'me.com', 'gmx.de', 'gmx.net', 'gmx.at', 'gmx.ch',\n  'web.de', 't-online.de', 'freenet.de', 'aol.com', 'proton.me', 'protonmail.com', 'mail.de', 'posteo.de']);\nconst GERMAN_SPEAKING = new Set(['DE', 'AT', 'CH', 'LI', 'LU']);\n\nconst b = $json.body ?? {};\nconst errors = [];\nconst text = (v, max = 200) => (typeof v === 'string' ? v.trim().replace(/\\s+/g, ' ').slice(0, max) : '');\n\nconst email = text(b.email, 254).toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(email)) errors.push('email: missing or invalid');\n\nlet firstName = text(b.firstName, 100);\nlet lastName = text(b.lastName, 100);\nif (!firstName && !lastName && text(b.name)) {\n  const parts = text(b.name).split(' ');\n  lastName = parts.pop();\n  firstName = parts.join(' ');\n}\nif (!firstName && !lastName) errors.push('name: firstName/lastName missing');\nif (b.consent !== true) errors.push('consent: must be true');\n\nconst country = text(b.country, 10).toUpperCase();\nif (country && !/^[A-Z]{2}$/.test(country)) errors.push('country: must be a 2-letter ISO code (e.g. DE)');\n\nconst budgetIn = b.estimatedBudget;\nconst budget = budgetIn === undefined || budgetIn === null || budgetIn === '' ? null : Number(budgetIn);\nif (budget !== null && (!Number.isFinite(budget) || budget < 0)) errors.push('estimatedBudget: must be a number >= 0');\n\nconst requested = text(b.language, 2).toLowerCase();\nconst language = ['de', 'en'].includes(requested) ? requested : GERMAN_SPEAKING.has(country) ? 'de' : 'en';\n\nconst emailDomain = email.split('@')[1] ?? '';\nconst website = text(b.website).toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').replace(/[/?#].*$/, '');\nconst companyDomain = website || (FREE_MAIL.has(emailDomain) ? '' : emailDomain);\nconst company = text(b.company);\n\n// Twenty filter used to find an existing company: by domain if we have one, else by exact name.\nconst q = (s) => s.replace(/\"/g, '');\nconst companyFilter = companyDomain\n  ? 'or(domainName.primaryLinkUrl[ilike]:\"%://' + q(companyDomain) + '\",domainName.primaryLinkUrl[ilike]:\"%://www.' + q(companyDomain) + '\",domainName.primaryLinkUrl[eq]:\"' + q(companyDomain) + '\")'\n  : company ? 'name[eq]:\"' + q(company) + '\"' : '';\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors,\n    lead: {\n      email, firstName, lastName, company, companyDomain, companyFilter,\n      phone: text(b.phone, 40).replace(/[^\\d+]/g, ''),\n      country: country || null,\n      language,\n      message: typeof b.message === 'string' ? b.message.trim().slice(0, 5000) : '',\n      estimatedBudget: budget,\n      source: text(b.source, 50) || 'website',\n    },\n    rawPayload: b,\n  },\n};"
      },
      "id": "7bb51f7d-2c2a-4406-ab1a-f7aeb6241d28"
    },
