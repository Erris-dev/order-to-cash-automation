    {
      "name": "Build Vendor Bill",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const doc = $('Load Document').item.json;\nconst call = $('When Called').item.json;\nconst vendorId = $('Use Existing Vendor').isExecuted\n  ? $('Use Existing Vendor').item.json.vendorId\n  : $('Use New Vendor').item.json.vendorId;\nconst taxByRate = Object.fromEntries($json.body.map((t) => [Number(t.amount), t.id]));\n\nconst lines = (doc.line_items ?? []).map((l) => {\n  const rate = Number(l.vat_rate_percent ?? 0);\n  if (rate && !taxByRate[rate]) throw new Error('No Odoo purchase tax for ' + rate + ' % (expected \"' + rate + '% I\")');\n  return [0, 0, {\n    name: l.description,\n    quantity: l.quantity,\n    price_unit: l.unit_price,\n    tax_ids: rate ? [[6, 0, [taxByRate[rate]]]] : [[5, 0, 0]],\n  }];\n});\nif (!lines.length) throw new Error('Document ' + doc.id + ' has no line items - cannot build a bill');\n\nconst how = call.approvedBy ? 'approved by ' + call.approvedBy + ' (WF-09)' : 'booked automatically (WF-04, confidence ' + doc.confidence + ')';\nreturn { json: { vals: {\n  move_type: 'in_invoice',\n  partner_id: Number(vendorId),\n  ref: doc.invoice_number,\n  invoice_date: doc.invoice_date,\n  ...(doc.due_date ? { invoice_date_due: doc.due_date } : {}),\n  narration: 'n8n document ' + doc.id + ': ' + how,\n  invoice_line_ids: lines,\n} } };"
      },
      "id": "c5b98558-45d6-4376-a67b-45db1941de08"
    },
