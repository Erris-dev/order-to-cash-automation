    {
      "id": "46cb8848-5237-41a1-a699-46d0303891de",
      "name": "Note: 3 · Find or create the Odoo customer",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1320,
        220
      ],
      "parameters": {
        "content": "## 3 · Find or create the Odoo customer\nLoads the opportunity with its company and point of contact (`depth=1`) and maps it\nto an Odoo `res.partner` (company → company partner; no company → the contact person).\nLookup order: **sync_map** → Odoo partner with `ref = twenty:<id>` → create.\nThe mapping is saved either way, so the next deal for this customer goes straight through.",
        "width": 1780,
        "height": 700,
        "color": 4
      }
    },
    {
      "name": "Get Opportunity Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_URL }}/rest/opportunities/{{ $('Verify Twenty Signature').item.json.payload.record.id }}?depth=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpBearerAuth": {
          "id": null,
          "name": "Twenty – Muster"
        }
      },
      "id": "5d6f0a7e-bcac-4b62-a3f5-6c88723dde05"
    },
    {
      "name": "Map Twenty → Odoo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const opp = $json.data.opportunity;\nconst company = opp.company ?? null;\nconst contact = opp.pointOfContact ?? null;\nif (!company && !contact) {\n  throw new Error('Opportunity ' + opp.id + ' has no company and no point of contact - cannot create an Odoo customer');\n}\n\nconst contactName = [contact?.name?.firstName, contact?.name?.lastName].filter(Boolean).join(' ');\nconst contactEmail = contact?.emails?.primaryEmail || false;\nconst contactPhone = contact?.phones?.primaryPhoneNumber\n  ? ((contact.phones.primaryPhoneCallingCode ?? '') + ' ' + contact.phones.primaryPhoneNumber).trim()\n  : false;\nconst address = company?.address ?? {};\nconst country = (address.addressCountry ?? '').trim();\n\nconst crm = company ? { object: 'companies', id: company.id } : { object: 'people', id: contact.id };\nconst partner = {\n  name: company ? company.name : contactName,\n  is_company: Boolean(company),\n  ref: 'twenty:' + crm.id,                       // stable link back to the CRM record\n  email: contactEmail,\n  phone: contactPhone,\n  website: company?.domainName?.primaryLinkUrl || false,\n  street: address.addressStreet1 || false,\n  zip: address.addressPostcode || false,\n  city: address.addressCity || false,\n};\n\nconst amount = opp.amount?.amountMicros != null ? opp.amount.amountMicros / 1e6 : 0;\nreturn {\n  json: {\n    opportunityId: opp.id,\n    opportunityName: opp.name,\n    amount,\n    currency: opp.amount?.currencyCode || 'EUR',\n    crm,\n    partner,\n    countryCode: /^[A-Za-z]{2}$/.test(country) ? country.toUpperCase() : 'DE', // Muster sells mainly in DE\n  },\n};"
      },
      "id": "78b8eb5f-e8ee-4db5-a190-1a5aa24cb1e3"
    },
