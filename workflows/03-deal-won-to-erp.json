      "parameters": {
        "content": "## 1 · Receive Twenty event\nTwenty calls **POST /webhook/twenty-opportunity** on every opportunity update\n(registered by **WF-00**). n8n answers 200 immediately; Twenty's timeout is 5 s.\n\nTwenty signs each call: `X-Twenty-Webhook-Signature = HMAC_SHA256(secret, timestamp + \":\" + body)`.\nUnsigned, stale (> 5 min) or tampered events are dropped and logged.",
        "width": 700,
        "height": 640,
        "color": 7
      }
    },
    {
      "name": "Twenty Opportunity Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "392d84c1-26c5-4186-a51a-97bad4f646a6",
      "parameters": {
        "httpMethod": "POST",
        "path": "twenty-opportunity",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "id": "714bb6e8-a4bd-444c-ae49-0f2867738532"
    },
    {
      "name": "Verify Twenty Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst MAX_AGE_MS = 5 * 60 * 1000;\n\nconst item = $input.first();\nconst headers = item.json.headers ?? {};\nconst secret = $env.TWENTY_WEBHOOK_SECRET;\nif (!secret) throw new Error('TWENTY_WEBHOOK_SECRET is not set');\n\nconst reject = (reason) => [{ json: { valid: false, reason } }];\n\nconst timestamp = String(headers['x-twenty-webhook-timestamp'] ?? '');\nconst signature = String(headers['x-twenty-webhook-signature'] ?? '');\nif (!timestamp || !signature) return reject('missing_signature_headers');\nif (!(Math.abs(Date.now() - Number(timestamp)) <= MAX_AGE_MS)) return reject('timestamp_outside_window');\nif (!item.binary?.data) return reject('empty_body');\n\n// Twenty signs \"<timestamp>:<JSON body>\" - the raw body is exactly that JSON.\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = crypto.createHmac('sha256', secret).update(timestamp + ':').update(raw).digest();\nconst given = Buffer.from(signature, 'hex');\nif (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return reject('signature_mismatch');\n\nreturn [{ json: { valid: true, payload: JSON.parse(raw.toString('utf8')) } }];"
      },
      "id": "6c36ec5c-28b5-48c4-abb3-6cba2661cb3a"
    },
