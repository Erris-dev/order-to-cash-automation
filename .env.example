# -----------------------------------------------------------------------------
# Copy to .env and fill in.  `scripts/generate-env.sh` does this for you and
# fills every <generate> value with a random secret.
# NEVER commit .env.
# -----------------------------------------------------------------------------

# --- Postgres ----------------------------------------------------------------
# Passwords are applied only when the postgres volume is created for the first
# time. Changing them later needs ALTER ROLE (see docs/RUNBOOK.md).
POSTGRES_PASSWORD=<generate>
N8N_DB_PASSWORD=<generate>
AUTOMATION_DB_PASSWORD=<generate>
ODOO_DB_PASSWORD=<generate>
TWENTY_DB_PASSWORD=<generate>
# Host port for psql / DBeaver (container port is 5432). 5434 avoids clashing
# with a local Postgres (5432) or other stacks (5433).
POSTGRES_HOST_PORT=5434

# --- n8n ---------------------------------------------------------------------
# Encrypts all credentials stored in n8n. Losing it = re-entering every credential.
N8N_ENCRYPTION_KEY=<generate>
# Shared secret between the n8n worker and its task-runner sidecar.
N8N_RUNNERS_AUTH_TOKEN=<generate>
# Public base URL (webhooks, links in emails). Change when using a tunnel,
# e.g. https://xyz.ngrok-free.app/
N8N_PUBLIC_URL=http://localhost:5678/

# --- Lead intake webhook (WF-01) --------------------------------------------
# The website signs each POST body with HMAC-SHA256 using this secret.
LEAD_WEBHOOK_HMAC_SECRET=<generate>
# Twenty signs its webhooks to n8n (WF-03) with this secret. WF-00 registers it.
TWENTY_WEBHOOK_SECRET=<generate>

# --- LLM (OpenRouter, OpenAI-compatible) -------------------------------------
# The API key itself is NOT set here – it goes into the n8n credential
# "OpenRouter – Muster" (see docs/SETUP.md). Only model names live here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_VISION_MODEL=openai/gpt-4.1-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Business rules -----------------------------------------------------------
ALERT_EMAIL_TO=you@example.com
HOT_LEAD_THRESHOLD=70
DOC_CONFIDENCE_THRESHOLD=0.85

# --- Twenty CRM ----------------------------------------------------------------
# Encrypts secrets Twenty stores (API keys, connected accounts).
TWENTY_ENCRYPTION_KEY=<generate>

# --- Document processing (WF-04) -------------------------------------------------
# Only mails matching this Gmail search are processed - keep it narrow, every
# matching PDF is sent to the LLM. Plus-addressing (you+invoices@...) arrives in
# your normal inbox but is easy to filter on.
INVOICE_MAIL_QUERY=to:you+invoices@example.com has:attachment filename:pdf
# Token for the test/demo upload webhook (scripts/upload-document.sh)
DOC_UPLOAD_TOKEN=<generate>
